# Run from the repository root with `doxygen Doxyfile`.
# Query with `MANPATH="$PWD/build/docs/man:" batman 3 Mini__SysWrite`.
PROJECT_NAME           = mini_libc
OUTPUT_DIRECTORY       = build/docs
INPUT                  = include/mini
FILE_PATTERNS          = *.h
STRIP_FROM_PATH        = include
OPTIMIZE_OUTPUT_FOR_C  = YES
HIDE_UNDOC_MEMBERS     = YES
WARN_IF_UNDOC_ENUM_VAL = YES
WARN_AS_ERROR          = FAIL_ON_WARNINGS
GENERATE_HTML          = YES
GENERATE_LATEX         = YES
GENERATE_MAN           = YES
MAN_LINKS              = YES
